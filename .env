# NeuroBoost Environment Variables
# ----------------------------------
# Note: Fill in the missing API keys below.

# --- Development Settings ---
NODE_ENV=development

# --- Port Bindings ---
# These map the container ports to your local machine
FRONTEND_PORT=8080
API_GATEWAY_PORT=3000
AI_AGENTS_PORT=8000
ANALYTICS_PORT=8001
VOICE_SERVICE_PORT=8002
WORKFLOW_ENGINE_PORT=8003

# --- Database Credentials (PostgreSQL) ---
POSTGRES_USER=neuroboost
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=neuroboost_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Cache Credentials (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password

# --- Security ---
# A strong, random string for signing JWTs
JWT_SECRET=your_super_secret_jwt_key

# --- REQUIRED API Keys (from hackathon sponsors) ---
# Fill these in with the keys from your dashboard
ANTHROPIC_API_KEY=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
GOOGLE_GEMINI_API_KEY=
GROQ_API_KEY=
LETTA_API_KEY=

# --- Voice Service (VAPI) ---
VAPI_API_KEY=
VAPI_PUBLIC_KEY=

# --- Workflow Engine (Orkes Conductor) ---
ORKES_API_KEY=
ORKES_SERVER_URL=https://play.orkes.io/ 